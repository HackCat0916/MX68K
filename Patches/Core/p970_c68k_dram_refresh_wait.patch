#   XEiJ 0.26.10.08 実装あり(XEiJ.java:6842, MemoryMappedDevice.java:82-99, MC68000.java:34)、Java方式で逐語移植不可。
#   sha256: XEiJ.java b7a6cad9…947181 / MemoryMappedDevice.java 817b2b90…cb0a3e / MC68000.java 40b55529…3d4a17
# Bridge代替検討: D1(データのみBridge課金)は効果の約1/4のみで却下。D2(チャンク終端PCで時間伸長)は命令ミックスを見ず
#   内部演算主体コードで過剰課金・P968のフェッチ単位課金と粒度混在・P808 carryと干渉で却下(フォールバックとしては成立)
# 対象ファイル:行範囲: Core/c68k/c68k.h:158-164 / Core/c68k/c68kmac.inc:180-190
# 由来サイクル: P970
#
# 適用方法: git apply Patches/Core/p970_c68k_dram_refresh_wait.patch
#           (★ユーザー自身が実行すること。エージェントは Core/ を編集しない)
#
# 併用が必須の Bridge 側変更: あり。Bridge/m68000_bridge.c の ROM/SRAM FetchWait値を1→8へ(同一コミット)、
#   C68K.FetchFrac を参照(データ側)。★本パッチを適用しない状態ではBridgeのビルドが失敗する。
#
# 挙動の同一性: MX68K_DEBUG_DRAM_WAIT未設定時はRAMバンクのFetchWaitTblが0、FetchFracは常に0で、
#   ROM/SRAM=8は1clkと等価 → P968適用後とビット単位で同一。
#
diff --git a/Core/c68k/c68k.h b/Core/c68k/c68k.h
index c38b94c..64050b0 100644
--- a/Core/c68k/c68k.h
+++ b/Core/c68k/c68k.h
@@ -158,8 +158,9 @@ typedef struct {
 
 	uintptr_t Fetch[C68K_FETCH_BANK];             // 32 bytes aligned
 
-    int32_t  FetchWait;                      // 現在PCバンクの1ワードあたりフェッチウェイト(clk)
-    uint8_t  FetchWaitTbl[C68K_FETCH_BANK];  // 64KBバンクごとのフェッチウェイト(0=なし)
+    int32_t  FetchWait;                      // 現在PCバンクの1ワードあたりフェッチウェイト(単位1/8clk、P970)
+    uint8_t  FetchWaitTbl[C68K_FETCH_BANK];  // 64KBバンクごとのフェッチウェイト(単位1/8clk、0=なし)
+    int32_t  FetchFrac;                      // P970: ウェイトの1/8clk端数アキュムレータ(0〜7)
 } c68k_struc;
 
 
diff --git a/Core/c68k/c68kmac.inc b/Core/c68k/c68kmac.inc
index 2e546e8..7a8ed93 100644
--- a/Core/c68k/c68kmac.inc
+++ b/Core/c68k/c68kmac.inc
@@ -180,9 +180,11 @@ extern void TRACE(int,c68k_struc*,int,int);
     CPU->A[7] += 4;
 #endif
 
-// P968: ROM/SRAM命令フェッチウェイト。PRE_IO/POST_IO窓内のフェッチでも消えないようCycleIOからも引く
+// P968/P970: 命令フェッチウェイト(単位1/8clk)。PRE_IO/POST_IO窓内のフェッチでも消えないようCycleIOからも引く
 #define FETCH_WAIT(n)       \
-(CCnt -= CPU->FetchWait * (n), CPU->CycleIO -= CPU->FetchWait * (n))
+(CPU->FetchFrac += CPU->FetchWait * (n), \
+ CCnt -= (CPU->FetchFrac >> 3), CPU->CycleIO -= (CPU->FetchFrac >> 3), \
+ CPU->FetchFrac &= 7)
 
 #define FETCH_BYTE          \
 (FETCH_WAIT(1), ((*(u16*)PC) & 0xFF))
