# 一次資料(構造そのもの): X68000 テクニカルデータブック 書籍p.155(PDF p.167)「(5)割り込み信号ステータス(In)・E9C001H」
#   D7 の説明(本パッチ作成時に PDF を画像で開いて確認):
#   「1:FDC 割り込み ON……リード/ライトの E-PHASE 終了によるリザルトステータスの読み取り要求、または SEEK、
#     RECALIBRATE コマンドの E-PHASE 終了による SENSE INTERRUPT STATUS コマンドの起動要求、またはデバイスの
#     状態遷移による SENSE INTERRUPT STATUS コマンドの起動要求」
#   → SENSE INT が要求されるのはシーク系終了(と状態遷移)のときだけで、R/W 終了はリザルト読取り要求(本修正の(1))。
#   補強: 同書 書籍p.152(PDF p.164)表4-14「各ドライブの現在のヘッド位置をFDCが記憶しており」(Fix Plan 作成時に確認)。
#   SENSE INT のリザルト長(2バイト=ST0, PCN)は同書 p.153 が「μPD72065データシートなどの資料を参照」として載せておらず、
#   手元に一次資料なし。根拠は独立2参照実装の一致+実機ログ(たんぼ氏、ふろっぴU君経由: C1 への SEEK 直後の
#   SENSE INT が ST0=0x20 → MSR 0xD0 → PCN=0x01 → MSR 0x80 の2バイト返答、P979 §0)。
# 実測根拠: [P981-SEEKCMP-SUM] total=200 match=20 mismatch=180 d0b_hist=[0x00:200] fdc_cmds=4372 seek_cmds=380
#   (Quarth.hdm FD 起動、P981)。IOCS のシーク確認 $FF8B1E cmp.b d0,d2(IPLROM md5 0617321daa182c3f3d6f41fd02fb3275)が
#   比べる PCN スロット $C91+drv*8 が常に 0(本マスクにより割込み処理 $FF1392 が PCN を読まない)ため、目標シリンダが
#   0 以外だと必ず不一致 → RECAL+再 SEEK。RECAL 184(P979 cmd_hist)− 4 = 180 = mismatch 180。[runtime log]+[算術]。
#   併せて、修正前の SENSE INT は READ/READ ID の後にも古い ST0 を返していた(rsp->st0 = fdc.st0、fdc.st0 を 0x80 へ
#   戻すのは case 8 だけ)。P979 cmd_hist 0x08=2910 = 2×(0x07:184+0x0f:380) + 2×(0x46:890+0x4a:1) と整数一致
#   ([static code reading]+[runtime log]+[算術])。保留フラグの移植でこれも消える(予測: 0x08 ≈ 1299)。
# 経緯: P979(FDC コマンド列の実機ログ照合で RECAL 過多を発見)→ P980(IOCS 逆アセンブルで $FF8B1E の PCN 比較を特定)
#   → P981(実行時プローブ [P981-SEEKCMP] で機構を確定)→ P982(本パッチ)。P980 §5 の最小修正案
#   (「st0==0x80 なら1バイト、それ以外は2バイト」)は、READ 後の古い ST0 で READ の ST1 スロット $C91+8n を cyl で
#   上書きするおそれ(仮説)があるため採らず、XM6/XEiJ の保留フラグ構造を移植した。
# 対象ファイル:行範囲: Core/px68k/x68k/fdc.c:63-84(FDC 構造体), 280-296(case 7/8), 338-347(case 15), 459-464(STATUS)
#   (適用前。最終変更 87981b5 = P686)
# 理由(1行): SENSE INTERRUPT STATUS の PCN を STATUS マスクで隠し、保留の有無に依らず古い ST0 を返していたため、
#   IOCS が PCN 不一致と判定して余分な RECAL+再 SEEK を出していた(D-101)
# 由来サイクル: P982
# 適用方法: git apply Patches/Core/p982_fdc_senseint_pcn.patch
#           撤回:  git apply -R Patches/Core/p982_fdc_senseint_pcn.patch
#           (★ユーザー自身が実行すること。エージェントは Core/ を編集しない)
# 環境変数: なし(既定 OFF のフラグは導入しない——CLAUDE.md「既定OFF放置パターン」規律は非該当)。
# 併用が必須の Bridge 側変更: なし。
#   注記: Bridge/floppyu_fdc_passthrough_probe.c:236(P955 振り分け器スタブ、D-8 凍結中・既定 OFF)は旧 Core のマスクを
#   まねたまま残る。凍結中のため本サイクルでは触らず、Docs/10 D-8 行に「再開時に整合が要る」と注記。
#   Bridge/m68000_bridge.c の [P686-FDCDRV] 診断は st0_last/st0_n の分布が変わる(READ 後の古い ST0 の SENSE が消える
#   ため。診断専用、ロースター外。P982 R-8 で想定内として事前記載)。
# 挙動の変化: 全機種共通(FDC デバイスエミュレーションは CPU コアに依らない)。保留なしの SENSE INT は 0x80 の1バイトを
#   返す(修正前は直前コマンドの ST0+cyl の2バイト。初回は 0x00)。保留ありの SENSE INT は ST0+PCN の2バイトで、
#   STATUS は2バイト目まで DIO/CB を立てたまま返す。seekint は FDC 構造体内なので FDC_Init() の memset でリセット時に
#   0 に戻る。FDC 構造体はステートセーブ対象ではないため保存形式は不変。
#
diff --git a/Core/px68k/x68k/fdc.c b/Core/px68k/x68k/fdc.c
index 36cb506..ce9c2eb 100644
--- a/Core/px68k/x68k/fdc.c
+++ b/Core/px68k/x68k/fdc.c
@@ -77,6 +77,7 @@ typedef struct {
 	int32_t st0;
 	int32_t st1;
 	int32_t st2;
+	int32_t seekint;	/* P982 (D-101): SEEK/RECALIBRATE 終了割込みの保留(SENSE INT 有効条件) */
 	uint8_t RspBuf[10];
 	uint8_t PrmBuf[10];
 	uint8_t DataBuf[0x8000];
@@ -287,11 +288,21 @@ static void FDC_ExecCmd(void)
 		} else {
 			fdc.st0 |= 0x50;		// ドライブなし
 		}
+		fdc.seekint = 1;
 		FDC_SetInt();
 		break;
 	case 8:		// SenseIntStatus
-		rsp->st0 = fdc.st0;
-		rsp->st1 = fdc.cyl;
+		/* P982 (D-101): 保留中のシーク終了割込みがあるときだけ ST0+PCN の2バイト、
+		 * 無いときは無効(0x80)の1バイト(XM6 vm/fdc.cpp:956-984,1672-1677,1710-1715 /
+		 * XEiJ FDC.java:1653-1721 と同じ構造) */
+		if ( fdc.seekint ) {
+			rsp->st0 = fdc.st0;
+			rsp->st1 = fdc.cyl;
+			fdc.seekint = 0;
+		} else {
+			rsp->st0 = 0x80;
+			fdc.rdnum = 1;
+		}
 		fdc.st0 = 0x80;
 		break;
 	case 10:	// ReadID
@@ -343,6 +354,7 @@ static void FDC_ExecCmd(void)
 		} else {
 			fdc.st0 |= 0x48;
 		}
+		fdc.seekint = 1;
 		FDC_SetInt();
 		break;
 	}
@@ -460,7 +472,6 @@ uint8_t FASTCALL FDC_Read(uint32_t adr)
 		ret  = 0x80;
 		ret |= ((fdc.rdnum)&&(!fdc.wexec))?0x40:0;
 		ret |= ((fdc.wrnum)||(fdc.rdnum))?0x10:0;
-		ret &= ((fdc.rdnum==1)&&(fdc.cmd==8))?0xaf:0xff;
 		break;
 	case 0x03:		/* Read data */
 		if ( fdc.bufnum ) {
