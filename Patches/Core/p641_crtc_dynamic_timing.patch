+void CRTC_UpdateHSyncClock(void)
+{
+	CrtcTiming t;
+	unsigned long long num, den;
+
+	CrtcTiming_FromRegs(CRTC_Regs, (SysPort[4] >> 1) & 1, &t);
+	CrtcTiming_CyclesPerRaster(&t, CRTC_TIMING_CLOCK, &num, &den);
