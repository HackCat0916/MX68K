#       /Users/toshinari/Desktop/XEiJ_0261008/xeij/YM2151.java /Users/toshinari/Desktop/XEiJ_0261008/xeij/MC68901.java
#   | 1b8be233b1e162d817b8c77412b7b3625117cd972dd94d710bd576b13f98664a  /Volumes/WD 8TB HDD/Develop/xm6/vm/opmif.cpp
#   | 7868115dd727a60c374357cfeffd2d98e0468c7fa882394b26675dcceca6f160  /Volumes/WD 8TB HDD/Develop/xm6/vm/mfp.cpp
#   | a728815a23b576ec9208c8ce820865a5c0e2f4ee74f657e50c7c896edceb15b3  /Users/toshinari/Desktop/XEiJ_0261008/xeij/YM2151.java
#   | f77ba69ac8045b809899c6eb1a54cb61951266343c05b3d96ee0708fde937947  /Users/toshinari/Desktop/XEiJ_0261008/xeij/MC68901.java
#   (GitHub 側ハッシュ libretro 3f4f542a・MPX68K ba935693・eCZ-600 9a2a6f99・Nuked-OPM f209e6ed の取得コマンドと生出力は
#    .mx68k_cycles/P1137_plan.md「記号表」直後・「参照diff」節に記載)
#   $ grep -n -a -A7 "void OPM::SetStatus" "/Volumes/WD 8TB HDD/Develop/px68k/fmgen/opm.cpp"   (px68k本家 74ddbb3)
#   | 141:void OPM::SetStatus(uint bits)
#   | 142-{
#   | 143-	if (!(status & bits))
#   | 144-	{
#   | 145-		status |= bits;
#   | 146-		Intr(true);
#   | 147-	}
#   | 148-}
#   (MPX68K ローカル 42fc340 "X68000 Shared/px68k/fmgen/opm.cpp":141-148 も同一内容)
