    "Write-protect FDD%lld. Turning it ON takes effect immediately, even on an inserted disk. To turn it OFF, eject and re-insert the disk to apply.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FDD%lld のライトプロテクト。ONは挿入中のディスクにも即座に反映されます。OFFにする場合は、一旦イジェクトして再挿入すると反映されます。"
          }
        }
      }
    },
    "Writing to drive %lld: Stopped until restart — FloppyU discarded unwritten data": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブ%lldへの書込み: 再起動まで停止中 — ふろっぴU君が未書込みのデータを破棄しました"
          }
        }
      }
    },
