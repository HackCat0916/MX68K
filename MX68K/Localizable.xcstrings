    "ROM30 (X68030 / 060turbo)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ROM30 (X68030 / 060turbo)"
          }
        }
      }
    },
    "ROM30: specify it together with its matching IPLROM30 (for the IPLROM 1.6 ROM30, use IPLROM30-1.6). Not used on 040turbo, including real-hardware ROMs (MX cannot tell ROM versions apart). Takes effect after a hard reset.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ROM30: 対になるIPLROM30(IPLROM 1.6のROM30なら、IPLROM30-1.6)と一緒に指定してください。040turboでは、実機版を含め使用されません(MXはROMの版を見分けられないため)。ハードリセットで反映されます。"
          }
        }
      }
    },
