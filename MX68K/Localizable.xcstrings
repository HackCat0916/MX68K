    "Safe (verify each write)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全優先(1セクタずつ書込み完了を確認)"
          }
        }
      }
    },
    "Safe waits for each sector to be physically written (about 4 minutes per disk). Fast lets FloppyU report success before the data reaches the disk (about 1 minute per disk).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全優先は1セクタずつ実際にディスクへ書き込まれるのを待ちます(1枚あたり約4分)。高速はデータがディスクに届く前にふろっぴU君が成功を返します(1枚あたり約1分)。"
          }
        }
      }
    },
    "Sample Rate": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプリングレート"
          }
        }
      }
