    "Absolute (follow host cursor)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絶対(ホストカーソルに追従)"
          }
        }
      }
    },
    "Absolute follows the host cursor position (recommended). Relative sends movement deltas (sensitivity slider active).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絶対はホストのカーソル位置に追従します(推奨)。相対は移動量を送ります(感度スライダ有効)。"
          }
        }
      }
    },
