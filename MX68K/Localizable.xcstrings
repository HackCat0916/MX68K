    "Extension": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張"
          }
        }
      }
    },
    "Fast FD Access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FD アクセス高速化"
          }
        }
      }
    },
    "Shortens the emulated seek/read/write waits to a fixed 64 µs, matching XM6's floppy disk speed-up option. Applies immediately.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーク・読込・書込のエミュレーション待ち時間を 64µs 固定へ短縮します(XM6 の「フロッピーディスク高速化」相当)。設定は即座に反映されます。"
          }
        }
      }
    },
    "Touch Controls": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチ操作"
          }
        }
      }
    },
    "Virtual Pad Opacity": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想パッドの不透明度"
          }
        }
      }
    },
    "Sets how visible the on-screen joystick overlay is. Applies immediately.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上に重ねて表示される仮想ジョイスティックの見えやすさを設定します。設定は即座に反映されます。"
          }
        }
      }
    },
    "Trigger Button Size": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガーボタンの大きさ"
          }
        }
      }
    },
    "Small": {
      "localizations": {
        "ja": {
          "stringUnit": {
