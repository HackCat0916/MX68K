    "Step may land on an exception entry when an interrupt is taken at the instruction boundary — the stopped PC and the listing below always show where execution actually is.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "命令境界で割込みが入った場合、ステップ実行が例外ハンドラの入口へ着地することがあります — 停止後の PC と下の逆アセンブル表示は、常に実際の実行位置を示します。"
          }
        }
      }
    },
    "stepped chunks: %llu": {
      "localizations": {
        "ja": {
          "stringUnit": {
