    "%@: File not found": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ファイルが見つかりません"
          }
        }
      }
    },
    "Enable gamepad": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームパッドを有効にする"
          }
        }
      }
    },
    "Use a connected controller as the X68000 joystick (port 1). D-pad and left stick move; A = trigger 1, B = trigger 2.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続されたコントローラをX68000のジョイスティック(1P)として使用します。十字キー/左スティックで移動、Aボタン=トリガー1、Bボタン=トリガー2。"
          }
        }
      }
    },
    "Up to two controllers are assigned to JOY1 and JOY2 in the order they connect.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラは接続された順に JOY1 → JOY2 の 2 台まで割り当てられます(3 台目以降は無視)。"
          }
        }
      }
    },
    "Choose which connected controller is assigned to each port. A newly connected controller is auto-assigned to the first free port; you can always override it here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのコントローラをどちらのポートに割り当てるかを選択します。新しく接続されたコントローラは空いている最も小さい番号のポートへ自動割当されますが、ここでいつでも変更できます。"
          }
        }
      }
    },
    "Port 1 (JOY1)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート1 (JOY1)"
          }
        }
      }
    },
    "Port 2 (JOY2)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート2 (JOY2)"
          }
        }
      }
    },
