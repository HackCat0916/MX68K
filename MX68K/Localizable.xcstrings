    "Cannot start recording while Turbo is on. Turn Turbo off first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターボ実行中は録画を開始できません。先にターボをOFFにしてください。"
          }
        }
      }
    },
    "Turbo is unavailable while recording. Stop recording first.": {
      "localizations": {
