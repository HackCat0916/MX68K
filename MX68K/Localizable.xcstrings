          "stringUnit": {
            "state": "translated",
            "value": "CD-ROM イメージとして不正です(2048 バイトまたは 2352 バイトのセクタサイズの倍数である必要があります)"
          }
        }
      }
    },
    "The guest has locked the CD-ROM drive — eject it from the guest first": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストが CD-ROM ドライブをロックしています — 先にゲスト側で取り出してください"
