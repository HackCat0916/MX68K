        }
      }
    },
    "Adjusts the size of the TRIG1/TRIG2 buttons. Applies immediately.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TRIG1/TRIG2 ボタンの大きさを変更します。設定は即座に反映されます。"
          }
        }
      }
    },
    "Auto-fire A": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連射 A"
          }
        }
      }
    },
    "Auto-fire B": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連射 B"
          }
        }
      }
    },
    "Rapid-fires the A/B buttons while held. Applies immediately.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "A/B ボタンを押している間、連射します。設定は即座に反映されます。"
          }
        }
      }
    },
    "Soft Keyboard Opacity": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトキーボードの不透明度"
          }
        }
      }
    },
    "Sets how visible the on-screen keyboard is. Applies immediately.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上に重ねて表示されるソフトキーボードの見えやすさを設定します。設定は即座に反映されます。"
          }
        }
      }
    },
    "⚠ Leave this off for titles whose copy protection depends on real floppy rotation timing — they may behave differently when it is on.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ フロッピーディスクの実回転タイミングに依存するコピープロテクトを持つタイトルでは、ON にすると動作が変わることがあります。その場合は OFF のままにしてください。"
          }
        }
      }
    },
    "FPU Enabled": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FPU 有効"
          }
        }
      }
    },
